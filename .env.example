# Optional cross-device sync (Supabase Auth + Postgres). Leave empty for local-only mode.
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are browser-safe public values.
# Never put a secret or service_role key in a NEXT_PUBLIC_ variable — it ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
